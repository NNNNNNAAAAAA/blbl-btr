<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="?attr/blblPageBackdrop" android:padding="16dp">
    <TextView android:id="@+id/tv_title" android:layout_width="0dp" android:layout_height="wrap_content"
        android:gravity="center" android:text="二维码登录" android:textSize="22sp" android:textStyle="bold"
        android:textColor="?attr/blblOnPageBackdrop" app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" app:layout_constraintTop_toTopOf="parent" />
    <ImageView android:id="@+id/iv_qr" android:layout_width="0dp" android:layout_height="0dp"
        android:layout_marginTop="16dp" android:background="?attr/colorSurface" android:padding="6dp"
        android:contentDescription="登录二维码" android:scaleType="fitCenter"
        app:layout_constraintWidth_max="240dp" app:layout_constraintDimensionRatio="1:1"
        app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tv_title" />
    <LinearLayout android:id="@+id/panel_right" android:layout_width="0dp" android:layout_height="wrap_content"
        android:orientation="vertical" android:layout_marginTop="12dp"
        app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/iv_qr">
        <TextView android:id="@+id/tv_status" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:gravity="center" android:minHeight="40dp" android:textSize="14sp"
            android:textColor="?attr/blblOnPageBackdropSecondary" />
        <com.google.android.material.button.MaterialButton android:id="@+id/btn_refresh"
            android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="8dp"
            android:text="刷新二维码" />
        <com.google.android.material.button.MaterialButton android:id="@+id/btn_clear"
            android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="8dp"
            android:text="清除登录" />
    </LinearLayout>
    <TextView android:id="@+id/tv_debug" android:layout_width="0dp" android:layout_height="wrap_content"
        android:alpha="0.55" android:textSize="10sp" android:maxLines="1" android:ellipsize="end"
        android:textColor="?attr/blblOnPageBackdropSecondary" app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" app:layout_constraintBottom_toBottomOf="parent" />
</androidx.constraintlayout.widget.ConstraintLayout>
