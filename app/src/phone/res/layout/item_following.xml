<?xml version='1.0' encoding='utf-8'?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="80dp" android:layout_height="80dp" android:layout_marginVertical="0dp" android:layout_marginHorizontal="2dp" android:clickable="true" android:focusable="true" android:stateListAnimator="@null" app:cardBackgroundColor="@android:color/transparent" app:cardCornerRadius="10dp" app:cardElevation="0dp" app:strokeColor="?attr/blblFocusStrokeFocusOnlyColor" app:strokeWidth="2dp" android:foreground="?attr/selectableItemBackground">
    <LinearLayout android:id="@+id/container" android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:orientation="vertical" android:paddingHorizontal="2dp" android:paddingVertical="2dp">
        <View android:id="@+id/v_selected" android:layout_width="28dp" android:layout_height="3dp" android:layout_marginEnd="0dp" android:background="?attr/blblAccent" android:visibility="gone" android:layout_marginBottom="3dp" />
        <FrameLayout android:layout_width="42dp" android:layout_height="42dp">
            <com.google.android.material.imageview.ShapeableImageView android:id="@+id/iv_avatar" android:layout_width="match_parent" android:layout_height="match_parent" android:contentDescription="@string/app_name" android:src="@android:drawable/sym_def_app_icon" app:shapeAppearanceOverlay="@style/ShapeAppearanceOverlay_Blbl_Circular" />
            <View android:id="@+id/v_avatar_update_dot" android:layout_width="@dimen/following_avatar_update_dot_size" android:layout_height="@dimen/following_avatar_update_dot_size" android:layout_gravity="bottom|end" android:layout_margin="@dimen/following_avatar_update_dot_margin" android:background="@drawable/bg_following_update_dot" android:visibility="gone" />
        </FrameLayout>
        <TextView android:id="@+id/tv_name" android:layout_width="match_parent" android:layout_height="18dp" android:layout_marginStart="0dp" android:ellipsize="end" android:gravity="center" android:maxLines="1" android:textColor="?attr/colorOnSurface" android:textSize="12sp" android:layout_marginTop="4dp" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
